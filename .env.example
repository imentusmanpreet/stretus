# ═══════════════════════════════════════════════════════════════
#  Stretus — Correct Windows .env
# ═══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=stretus-change-this-secret-key-2024
APP_DEBUG=true


# ── PostgreSQL (Primary Database) ─────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stretus
POSTGRES_USER=stretus
POSTGRES_PASSWORD=stretus_db

DATABASE_URL=postgresql+asyncpg://stretus:stretus_db@localhost:5432/stretus
DATABASE_URL_SYNC=postgresql+psycopg2://stretus:stretus_db@localhost:5432/stretus


# ── AI Provider (Groq → Ollama fallback) ───────────────────────
LLM_PROVIDER=auto


# ── Groq Cloud LLM ─────────────────────────────────────────────

GROQ_MODEL=llama-3.3-70b-versatile


# ── Ollama Local (Windows Host Access) ─────────────────────────
# Docker container accesses Windows using host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b


# ── Project Paths ─────────────────────────────────────────────
STRATEGY_FOLDER=./strategies


# ── External Services ──────────────────────────────────────────
QUANT_ENGINE_URL=http://quant_engine:8001

# Ngrok tunnel to your local OHLCV / historical data server.
# Used ONLY by the backtest service.
HISTORICAL_DATA_URL=https://your-ngrok-url.ngrok-free.app

# Days of OHLCV fetched for signal parameter estimation (planner only).
# Keep this small (≤60) to avoid rate-limit errors on 1-minute intervals.
SIGNAL_EVAL_LOOKBACK_DAYS=30

# Chunk size for backtest OHLCV fetching. The full configured backtest range
# (BACKTEST_MARKET_DATA_FROM_UTC → TO_UTC) is split into windows of this many
# days and fetched sequentially. Smaller = fewer 429s, more round-trips.
BACKTEST_FETCH_CHUNK_DAYS=90

# Upstox v2 base URL.
# Used by the execution service for ALL live market data:
#   candles (Upstox historical-candle API), LTP, and circuit limits.
MARKET_DATA_URL=https://api.upstox.com/v2


# ── Upstox credentials (execution service) ─────────────────────
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=
MARKET_DATA_CACHE_TTL_SECONDS=60
