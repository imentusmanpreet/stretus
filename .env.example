# ═══════════════════════════════════════════════════════════════
#  Stretus — Correct Windows .env
# ═══════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=stretus-change-this-secret-key-2024
APP_DEBUG=true


# ── PostgreSQL (Primary Database) ─────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stretus
POSTGRES_USER=stretus
POSTGRES_PASSWORD=stretus_db

DATABASE_URL=postgresql+asyncpg://stretus:stretus_db@localhost:5432/stretus
DATABASE_URL_SYNC=postgresql+psycopg2://stretus:stretus_db@localhost:5432/stretus


# ── AI Provider (OpenRouter only) ──────────────────────────────
# Options: openrouter, groq, ollama, auto
# - openrouter: Use OpenRouter API (primary)
# - groq: Use GROQ API (fast inference)
# - ollama: Use local Ollama
# - auto: Try OpenRouter → GROQ → Ollama
LLM_PROVIDER=openrouter


# ── OpenRouter Cloud LLM ───────────────────────────────────────

OPENROUTER_API_KEY=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
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct


# ── GROQ Cloud LLM (Fallback for OpenRouter 429 errors) ────────
# Multiple API keys for automatic rotation on rate limits
# Format: 1:key1,2:key2,3:key3 or key1,key2,key3
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# ── Project Paths ─────────────────────────────────────────────
STRATEGY_FOLDER=./strategies


# ── External Services ──────────────────────────────────────────
QUANT_ENGINE_URL=http://quant_engine:8001

# Timeout settings (in seconds)
QUANT_ENGINE_TIMEOUT_SECONDS=600
HISTORICAL_DATA_TIMEOUT_SECONDS=120

# Backtest OHLCV transport: auto | grpc | http
# On EKS, set MARKET_DATA_GRPC_TARGET and use auto or grpc (skips User-Gateway/BFF).
MARKET_DATA_FETCH_TRANSPORT=auto
# EKS dev2 FQDN (same as BFF). Local/docker: marketdata-ingestion:50057 if on shared network.
MARKET_DATA_GRPC_TARGET=marketdata-ingestion.stretus-ai-dev2.svc.cluster.local:50057
MARKET_DATA_GRPC_TIMEOUT_SECONDS=120
MARKET_DATA_GRPC_SECURE=false

# HTTP fallback (local dev / when gRPC target is empty with transport=auto).
# Also used by execution market data (live candles, LTP) via user-gateway.
HISTORICAL_DATA_URL=https://your-ngrok-url.ngrok-free.app

# Days of OHLCV fetched for signal parameter estimation (planner only).
# Keep this small (≤60) to avoid rate-limit errors on 1-minute intervals.
SIGNAL_EVAL_LOOKBACK_DAYS=30

# Chunk size for backtest OHLCV fetching. The full configured backtest range
# (BACKTEST_MARKET_DATA_FROM_UTC → TO_UTC) is split into windows of this many
# days and fetched sequentially. Smaller = fewer 429s, more round-trips.
BACKTEST_FETCH_CHUNK_DAYS=90

# Earliest UTC start date accepted for user-requested backtest ranges.
BACKTEST_EARLIEST_FROM_UTC=2024-01-01T00:00:00Z
# Max/min calendar days of pre-window fetch when user sets a custom backtest range
BACKTEST_USER_RANGE_MAX_PADDING_DAYS=90
BACKTEST_USER_RANGE_MIN_PADDING_DAYS=14

# ── Multi-tenant (optional) ────────────────────────────────────
# Single-tenant deploy: set tenant code from ref_data.tenants.code.
# Multi-tenant deploy: leave empty; callers (strategy / order-execution) send x-tenant-id.
# TENANT_CODE=stretus_internal

# Per-tenant credentials live in ref_data.system_configs (not user_schema), e.g.:
#   tenant.<uuid>.broker.credentials.upstox_rest.access_token
#   tenant.<uuid>.broker.credentials.binance_rest.api_key
#   tenant.<uuid>.broker.credentials.binance_rest.secret_key
# Env vars below are LEGACY FALLBACK when DB keys are not seeded.

# Go user-gateway: set EXCHANGE_TICKER_BASE_URL to override the default
# Binance Spot URL used for the /api/v1/marketdata/ticker/24hr endpoint.
# EXCHANGE_TICKER_BASE_URL=https://api.binance.com

# ── Legacy direct-broker env vars (kept for order-execution adapters) ──
# These are no longer used for market data reads; InternalMarketDataClient
# routes all reads through stretus-backend instead.
MARKET_DATA_URL=https://api.upstox.com/v2
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=
MARKET_DATA_CACHE_TTL_SECONDS=60
